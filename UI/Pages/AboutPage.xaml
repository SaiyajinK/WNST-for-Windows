<Grid x:Name="AboutPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="AboutTitle" Text="À propos" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="AboutSubtitle" Text="" Visibility="Collapsed"/></StackPanel>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0"><StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0" VerticalAlignment="Top">
              <Border x:Name="AboutProfileCard" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Width="104" Height="104" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource InputBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                    <Image x:Name="AboutAvatar" Width="100" Height="100" Stretch="UniformToFill">
                      <Image.Clip><EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/></Image.Clip>
                    </Image>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="SaiyajinK" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutBio" Text="The right man in the wrong place can make all the difference in the world." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"/>
                  </StackPanel>
                  <Button x:Name="GitHubProfileButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M8,0.7 C3.9,0.7 0.6,4 0.6,8.1 C0.6,11.4 2.7,14.2 5.7,15.2 C6.1,15.3 6.2,15 6.2,14.8 C6.2,14.5 6.2,13.5 6.2,12.3 C4.1,12.7 3.6,11.4 3.6,11.4 C3.3,10.5 2.8,10.3 2.8,10.3 C2.1,9.8 2.9,9.8 2.9,9.8 C3.7,9.9 4.1,10.6 4.1,10.6 C4.8,11.8 5.9,11.5 6.3,11.3 C6.4,10.8 6.6,10.4 6.8,10.2 C5.1,10 3.4,9.4 3.4,6.5 C3.4,5.7 3.7,5 4.2,4.5 C4.1,4.3 3.8,3.5 4.3,2.5 C4.3,2.5 5,2.3 6.4,3.3 C7.1,3.1 7.7,3 8.4,3 C9.1,3 9.7,3.1 10.4,3.3 C11.8,2.3 12.5,2.5 12.5,2.5 C13,3.5 13,4.3 12.6,4.5 C13.1,5 13.4,5.7 13.4,6.5 C13.4,9.4 11.7,10 10,10.2 C10.3,10.5 10.5,11 10.5,11.7 C10.5,12.8 10.5,14.3 10.5,14.8 C10.5,15.1 10.7,15.3 11,15.2 C14,14.2 16.1,11.4 16.1,8.1 C16.1,4 12.8,0.7 8.7,0.7 Z"/><TextBlock x:Name="GitHubButtonText" Text="GitHub" Margin="7,0,0,0"/></StackPanel></Button>
                </Grid>
              </Border>
              <Border x:Name="AboutProductCard" Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="WNST" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AboutProductName" Text="Windows Network &amp; System Toolkit" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock x:Name="AboutDescription" Text="WNST regroupe le fichier hosts, le DNS, le pare-feu et des outils Windows dans une interface PowerShell compacte." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock x:Name="VersionText" Text="Version 1.0.0" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,10,0,0"/>
                  </StackPanel>
                  <Button x:Name="RepositoryButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M8,0.7 C3.9,0.7 0.6,4 0.6,8.1 C0.6,11.4 2.7,14.2 5.7,15.2 C6.1,15.3 6.2,15 6.2,14.8 C6.2,14.5 6.2,13.5 6.2,12.3 C4.1,12.7 3.6,11.4 3.6,11.4 C3.3,10.5 2.8,10.3 2.8,10.3 C2.1,9.8 2.9,9.8 2.9,9.8 C3.7,9.9 4.1,10.6 4.1,10.6 C4.8,11.8 5.9,11.5 6.3,11.3 C6.4,10.8 6.6,10.4 6.8,10.2 C5.1,10 3.4,9.4 3.4,6.5 C3.4,5.7 3.7,5 4.2,4.5 C4.1,4.3 3.8,3.5 4.3,2.5 C4.3,2.5 5,2.3 6.4,3.3 C7.1,3.1 7.7,3 8.4,3 C9.1,3 9.7,3.1 10.4,3.3 C11.8,2.3 12.5,2.5 12.5,2.5 C13,3.5 13,4.3 12.6,4.5 C13.1,5 13.4,5.7 13.4,6.5 C13.4,9.4 11.7,10 10,10.2 C10.3,10.5 10.5,11 10.5,11.7 C10.5,12.8 10.5,14.3 10.5,14.8 C10.5,15.1 10.7,15.3 11,15.2 C14,14.2 16.1,11.4 16.1,8.1 C16.1,4 12.8,0.7 8.7,0.7 Z"/><TextBlock x:Name="RepositoryButtonText" Text="GitHub" Margin="7,0,0,0"/></StackPanel></Button>
                </Grid>
              </Border>
              <Border x:Name="AboutSupportCard" Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="AboutSupportTitle" Text="Soutenir le projet" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock x:Name="AboutStarHint"
                                 Text="Vous aimez l'utilitaire ? Mettez une étoile sur le dépôt GitHub !"
                                 Foreground="{DynamicResource MutedBrush}"
                                 TextWrapping="NoWrap" FontSize="12"/>
                      <Path Width="13"
                            Height="13"
                            Margin="5,1,0,0"
                            VerticalAlignment="Top"
                            Stretch="Uniform"
                            Fill="#FFD700"
                            Data="M10,1 L12.6,6.7 L19,7.4 L14.3,11.8 L15.6,18 L10,14.8 L4.4,18 L5.7,11.8 L1,7.4 L7.4,6.7 Z"/>
                    </StackPanel>
                  </StackPanel>
                  <Button x:Name="KoFiButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Canvas Width="16" Height="15">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,3 L12,3 L11,11 C10.5,13 3,13 2.5,11 Z M12,5 L15,5 L15,9 L11.5,10"/>
                        <Ellipse Canvas.Left="5" Canvas.Top="6" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </Canvas>
                      <TextBlock x:Name="KoFiButtonText" Text="Ko-fi" Margin="7,0,0,0"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Border x:Name="AboutUpdateCard" Margin="0,10,0,0" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="UpdateCheckTitle" Text="Mises à jour" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="UpdateCheckStatus" Text="Vérifiez si une nouvelle release est disponible sur GitHub." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,18,0"/></StackPanel><Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource GreenHoverButtonStyle}" Content="Rechercher les mises à jour" VerticalAlignment="Center"/></Grid></Border>
              <Border x:Name="UpdateResultPanel" Margin="0,8,0,0" Padding="11,7" CornerRadius="{DynamicResource AppCornerRadius}" BorderThickness="1" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><Ellipse x:Name="UpdateResultDot" Width="8" Height="8" VerticalAlignment="Center"/><TextBlock x:Name="UpdateResultText" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="UpdateResultAction" Grid.Column="3" Style="{StaticResource AccentHoverButtonStyle}" Content="GitHub ↗" Margin="12,0,0,0" Visibility="Collapsed"/><Button x:Name="UpdateResultClose" Grid.Column="5" Style="{StaticResource CloseButtonStyle}" Width="26" Height="24" FontSize="14" Content="×" ToolTip="Fermer"/></Grid></Border>
              <Grid Width="{Binding ActualWidth, ElementName=AboutUpdateCard}" HorizontalAlignment="Left" Margin="0,14,0,4"><TextBlock Text="© 2026 SaiyajinK" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/></Grid>
            </StackPanel></ScrollViewer>
          </Grid>
