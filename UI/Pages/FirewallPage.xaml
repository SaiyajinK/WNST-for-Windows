<Grid x:Name="FirewallPage" Visibility="Collapsed" Style="{StaticResource PageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="FirewallTitle" Text="Pare-feu" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="FirewallSubtitle" Text="Créez et gérez uniquement les règles appartenant à WNST." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,10"><StackPanel>
              <TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="FirewallAddTitle" Text="Ajouter des applications" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="FirewallAddHint" Text="Sélectionnez un ou plusieurs exécutables, puis choisissez leur accès réseau." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" FontSize="12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FirewallProgramBox" IsReadOnly="True"/><Button x:Name="BrowseFirewallProgramsButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Sélectionner des applications…" Padding="14,4" MinWidth="178"/><Button x:Name="BrowseFirewallFolderButton" Grid.Column="4" Style="{StaticResource AccentHoverButtonStyle}" Content="Sélectionner un dossier…" Padding="14,4" MinWidth="166"/></Grid>
              <Border x:Name="FirewallPendingPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="FirewallPendingTitle" Text="Applications sélectionnées" FontWeight="SemiBold" Margin="1,0,0,6"/><DataGrid x:Name="FirewallPendingGrid" Grid.Row="1" Height="104" SelectionMode="Extended" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn x:Name="FirewallPendingNameColumn" Header="Application" Binding="{Binding Name}" Width="180"/><DataGridTextColumn x:Name="FirewallPendingPathColumn" Header="Chemin" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0"><Button x:Name="RemovePendingFirewallButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Retirer la sélection" IsEnabled="False"/><Button x:Name="ClearPendingFirewallButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Tout retirer" Margin="7,0,0,0"/></StackPanel></Grid></Border>
              <Grid Margin="0,9,0,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="FirewallInboundCheck" Content="Entrant" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/><CheckBox x:Name="FirewallOutboundCheck" Grid.Column="1" Content="Sortant" IsChecked="True" VerticalAlignment="Center"/><TextBlock x:Name="FirewallActionLabel" Grid.Column="3" Text="Action" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="FirewallActionCombo" Grid.Column="4" DisplayMemberPath="Name" VerticalAlignment="Center"/><TextBlock x:Name="FirewallProfileLabel" Grid.Column="6" Text="Profil" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="FirewallProfileCombo" Grid.Column="7" DisplayMemberPath="Name" VerticalAlignment="Center"/><Button x:Name="AddFirewallRulesButton" Grid.Column="9" Style="{StaticResource AccentHoverButtonStyle}" Content="Ajouter les règles" VerticalAlignment="Center"/></Grid>
            </StackPanel></Border>
            <Border Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="FirewallRulesTitle" Text="Règles WNST" FontSize="16" FontWeight="SemiBold" Margin="2,8,0,9"/>
              <Border Grid.Row="1" Background="{DynamicResource GridBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="1"><DataGrid x:Name="FirewallGrid" BorderThickness="0" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.ContextMenu><ContextMenu x:Name="FirewallContextMenu" Style="{StaticResource BackupContextMenuStyle}"><MenuItem x:Name="DeleteFirewallMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Supprimer" Tag="Danger"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn x:Name="FirewallNameColumn" Header="Application" Binding="{Binding DisplayName}" Width="170"/><DataGridTextColumn x:Name="FirewallPathColumn" Header="Chemin" Binding="{Binding Program}" Width="*"/><DataGridTextColumn x:Name="FirewallDirectionColumn" Header="Direction" Binding="{Binding DisplayDirection}" Width="90"/><DataGridTextColumn x:Name="FirewallActionColumn" Header="Action" Binding="{Binding DisplayAction}" Width="85"/><DataGridTextColumn x:Name="FirewallProfileColumn" Header="Profil" Binding="{Binding DisplayProfile}" Width="105"/><DataGridTextColumn x:Name="FirewallStatusColumn" Header="État" Binding="{Binding DisplayEnabled}" Width="85"/></DataGrid.Columns></DataGrid></Border>
              <Grid Grid.Row="2" Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="DeleteFirewallRulesButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Supprimer la sélection" IsEnabled="False"/><Button x:Name="EnableFirewallRulesButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Activer" Margin="7,0,0,0" IsEnabled="False"/><Button x:Name="DisableFirewallRulesButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Désactiver" Margin="7,0,0,0" IsEnabled="False"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenAdvancedFirewallButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le pare-feu avancé"/><Button x:Name="RefreshFirewallButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Actualiser" Margin="7,0,0,0"/></StackPanel></Grid>
            </Grid></Border>
          </Grid>
