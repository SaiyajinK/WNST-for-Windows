<Grid x:Name="ConnectionsPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="ConnectionsTitle" Text="Connexions" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="ConnectionsSubtitle" Text="Visualisez les applications connectées et contrôlez la connexion active." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0"><StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
              <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="LiveConnectionsTitle" Text="Applications connectées" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="LiveConnectionsHint" Text="Connexions TCP actives regroupées avec leur processus propriétaire." Foreground="{DynamicResource MutedBrush}" Margin="0,3,12,9" FontSize="12"/></StackPanel><Button x:Name="RefreshConnectionsButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Actualiser" VerticalAlignment="Center"/></Grid>
                <Border Grid.Row="1" Background="{DynamicResource GridBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="1"><DataGrid x:Name="ConnectionsGrid" BorderThickness="0" Height="235" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.ContextMenu><ContextMenu x:Name="ConnectionsContextMenu" Style="{StaticResource BackupContextMenuStyle}"><MenuItem x:Name="ConnectionOpenLocationMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Ouvrir l’emplacement"/><MenuItem x:Name="ConnectionStopMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Arrêter le processus" Tag="Danger"/><MenuItem x:Name="ConnectionFirewallMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Créer une règle pare-feu"/><MenuItem x:Name="ConnectionPingMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Tester avec Ping"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn x:Name="ConnectionAppColumn" Header="Application" Binding="{Binding ProcessName}" Width="150"/><DataGridTextColumn x:Name="ConnectionPidColumn" Header="PID" Binding="{Binding PID}" Width="65"/><DataGridTextColumn x:Name="ConnectionRemoteColumn" Header="Adresse distante" Binding="{Binding RemoteEndpoint}" Width="180"/><DataGridTextColumn x:Name="ConnectionProtocolColumn" Header="Protocole" Binding="{Binding Protocol}" Width="75"/><DataGridTextColumn x:Name="ConnectionStateColumn" Header="État" Binding="{Binding State}" Width="95"/><DataGridTextColumn x:Name="ConnectionPathColumn" Header="Chemin" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid></Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0"><Button x:Name="OpenConnectionLocationButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir l’emplacement" IsEnabled="False"/><Button x:Name="StopConnectionProcessButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Arrêter le processus" Margin="7,0,0,0" IsEnabled="False"/><Button x:Name="ConnectionToFirewallButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Créer une règle pare-feu" Margin="7,0,0,0" IsEnabled="False"/></StackPanel>
              </Grid></Border>
              <Border Background="Transparent" BorderThickness="0" Padding="0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ActiveConnectionCardTitle" Text="Connexion réseau active" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/><Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="NetworkToggleTitle" Text="Carte utilisée par Internet" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="NetworkToggleHint" Text="Désactive ou réactive précisément la carte actuellement utilisée." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="NetworkEnableButton" Style="{StaticResource GreenHoverButtonStyle}" Content="Activer" Margin="0,0,7,0"/>
                  <Button x:Name="NetworkDisableButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Désactiver"/>
                </StackPanel></Grid></Border></StackPanel></Border>
            </StackPanel></ScrollViewer>
          </Grid>
