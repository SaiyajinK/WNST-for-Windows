<Grid x:Name="HistoryPage" Visibility="Collapsed" Style="{StaticResource PageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="HistoryTitle" Text="Historique" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="HistorySubtitle" Text="Sauvegardes créées automatiquement avant chaque modification." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <Grid Grid.Row="1" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Padding="0" Background="Transparent" BorderThickness="0"><Border Background="{DynamicResource GridBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="1"><DataGrid x:Name="BackupGrid" BorderThickness="0" AlternationCount="2"><DataGrid.ContextMenu><ContextMenu x:Name="BackupContextMenu" Style="{StaticResource BackupContextMenuStyle}"><MenuItem x:Name="ModifyBackupMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Modifier"/><MenuItem x:Name="DeleteBackupMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Supprimer" Tag="Danger"/><MenuItem x:Name="DetailBackupMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Détail"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn x:Name="DateColumn" Header="Date" Binding="{Binding DisplayDate}" Width="145"/><DataGridTextColumn x:Name="NameColumn" Header="Sauvegarde" Binding="{Binding Name}" Width="*"/><DataGridTextColumn x:Name="SizeColumn" Header="Taille" Binding="{Binding DisplaySize}" Width="82"/></DataGrid.Columns></DataGrid></Border></Border><Border x:Name="BackupPreviewPanel" Grid.Column="1" Width="305" Margin="10,0,0,0" Style="{StaticResource CardStyle}" Padding="10" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="BackupPreviewTitle" Text="Aperçu" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="BackupPreviewCloseButton" Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Width="26" Height="24">
  <Viewbox Width="11" Height="11">
    <Canvas Width="12" Height="12">
      <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
            StrokeThickness="1.5"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            Data="M1,1 L11,11 M11,1 L1,11"/>
    </Canvas>
  </Viewbox>
</Button></Grid><TextBlock x:Name="BackupPreviewMeta" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/><Border Grid.Row="2" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="8"><Grid><ScrollViewer x:Name="BackupPreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="BackupPreviewText" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Foreground="{DynamicResource TextBrush}"/></ScrollViewer><Canvas x:Name="BackupPreviewCustomScrollTrack" Width="9" HorizontalAlignment="Right" Margin="0,0,0,9" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="2"><Thumb x:Name="BackupPreviewCustomScrollThumb" Style="{StaticResource ScrollThumbStyle}" Width="9" Height="24" Canvas.Left="0" Canvas.Top="0"/></Canvas></Grid></Border></Grid></Border></Grid>
            <Grid Grid.Row="2">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Margin" Value="0"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="Margin" Value="0,0,0,20"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="DeleteSelectedBackupButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Supprimer la sélection" Margin="0,0,6,0"/><Button x:Name="ClearHistoryButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Tout supprimer"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenBackupFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier" Margin="0,0,6,0"/><Button x:Name="RefreshHistoryButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Actualiser" Margin="0,0,6,0"/><Button x:Name="RestoreSelectedButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Restaurer la sélection"/></StackPanel>
            </Grid>
          </Grid>
