<Grid x:Name="DiagnosticsPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center">
    <TextBlock x:Name="DiagnosticsTitle" Text="Diagnostics" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/>
    <TextBlock x:Name="DiagnosticsSubtitle" Text="Analysez l’intégrité de Windows, de vos disques et des principaux composants système." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0">
    <StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
      <Border x:Name="IntegrityCard" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><StackPanel>
        <TextBlock x:Name="IntegrityTitle" Text="Intégrité de Windows et des disques" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DismScanTitle" Text="Analyser l’image Windows" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="DismScanHint" Text="Vérifie les composants Windows avec DISM /ScanHealth sans les modifier." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="DismScanButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Analyser"/></Grid>
          <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DismRepairTitle" Text="Réparer l’image Windows" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="DismRepairHint" Text="Répare le magasin de composants avec DISM /RestoreHealth." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="DismRepairButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Réparer"/></Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="SfcToolTitle" Text="Vérification des fichiers système" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="SfcToolHint" Text="Analyse et répare les fichiers protégés de Windows avec SFC /scannow." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="SfcScanButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Analyser avec SFC"/></Grid></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="ChkdskTitle" Text="Vérifier les volumes" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ChkdskHint" Text="Lance CHKDSK /scan sur les volumes fixes sans planifier de redémarrage." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="ChkdskButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Analyser"/></Grid></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DriveHealthTitle" Text="Santé SSD et HDD" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="DriveHealthHint" Text="Affiche l’état SMART, le type de média, la taille et la fiabilité disponibles." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="DriveHealthButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Vérifier"/></Grid></Border>
        <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="PathRepairTitle" Text="Réparer le PATH Windows" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="PathRepairHint" Text="Restaure uniquement les entrées Windows essentielles manquantes, sans supprimer vos chemins personnalisés." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="RepairPathButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Réparer le PATH"/></Grid></Border>
      </StackPanel></Border>
      <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><StackPanel>
        <TextBlock x:Name="DiagnosticsAdvancedTitle" Text="Diagnostic avancé et restauration" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BootDiagnosticsTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Options BSOD et démarrage détaillés" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="BootDiagnosticsHint" Text="Affiche les paramètres d’arrêt, active le journal de démarrage et le menu de démarrage détaillé." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/><TextBlock x:Name="BootDiagnosticsStatus" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,20,0"/></StackPanel><ToggleButton x:Name="BootDiagnosticsToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid></Border>
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="VerboseLogonTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Ouverture et fermeture de session détaillées" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="VerboseLogonHint" Text="Affiche les opérations exécutées par Windows pendant la connexion, la déconnexion et l’arrêt." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/><TextBlock x:Name="VerboseLogonStatus" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,20,0"/></StackPanel><ToggleButton x:Name="VerboseLogonToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid></Border>
        <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SystemRestoreTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Restauration système" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="SystemRestoreHint" Text="Crée un point de restauration ou ouvre l’assistant natif pour restaurer Windows." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/><TextBlock x:Name="SystemRestoreStatus" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,20,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CreateRestorePointButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Créer un point" Margin="0,0,7,0"/><Button x:Name="OpenSystemRestoreButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Restaurer"/></StackPanel></Grid></Border>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource StickyLogCardStyle}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="IntegrityLogTitle" Text="Journal d’intégrité" FontWeight="SemiBold"/><TextBlock x:Name="IntegrityLogHint" Text="Affiche en direct les diagnostics, réparations et opérations de restauration." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,12,5"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="ExportIntegrityLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Exporter" Margin="0,0,7,0"/><Button x:Name="OpenIntegrityLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le fichier" Margin="0,0,7,0"/><Button x:Name="OpenIntegrityLogFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier" Margin="0,0,7,0"/><Button x:Name="ClearIntegrityLogButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Vider"/></WrapPanel></Grid><Grid x:Name="IntegrityLogPanel" Height="145" Margin="0,6,0,0"><RichTextBox x:Name="IntegrityOutputBox" Style="{StaticResource LogRichTextBoxStyle}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12"><FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="12"><Paragraph Margin="0"/></FlowDocument></RichTextBox></Grid></StackPanel></Border>
</Grid>
