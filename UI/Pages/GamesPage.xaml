<Grid x:Name="GamesPage" Visibility="Collapsed" Style="{StaticResource SoftwarePageRootStyle}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Style="{StaticResource SoftwareFixedContentStyle}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="GamesTitle" Text="Jeux" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/>
      <TextBlock x:Name="GamesSubtitle" Text="Launchers et réglages Windows dédiés au jeu." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
    </StackPanel>
    <Button x:Name="GamesOpenDownloadsButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" VerticalAlignment="Center" Visibility="Collapsed" Content="Ouvrir les téléchargements"/>
  </Grid>

  <Border x:Name="GamesProgressCard" Grid.Row="1" Style="{StaticResource SoftwareStickyCardStyle}">
    <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GamesProgressTitle" Text="Progression" FontWeight="SemiBold" Foreground="{DynamicResource CardTitleBrush}"/><TextBlock x:Name="GamesProgressStatus" Text="Prêt" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="GamesProgressPercent" Grid.Column="1" Text="0 %" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="GamesClearProgressButton" Grid.Column="2" Width="28" Height="28" Padding="0" Margin="9,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" Style="{StaticResource AccentHoverButtonStyle}"><Viewbox Width="15" Height="15"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M13.5,1.5 L7.2,7.8 M6.1,6.8 L9,9.7 L6.5,13.5 L2,14 L2.5,9.5 Z M4.2,9.8 L7,12.6"/></Viewbox></Button></Grid>
      <ProgressBar x:Name="GamesProgressBar" Style="{StaticResource RoundedProgressBarStyle}" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0"/>
      <TextBlock x:Name="GamesProgressDetails" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
  </Border>

  <ScrollViewer x:Name="GamesCatalogScrollViewer" Grid.Row="2" Margin="0,0,-18,0" Style="{StaticResource SoftwarePageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Style="{StaticResource SoftwarePageScrollContentStyle}" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border x:Name="GamesLaunchersCard" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock x:Name="GamesLaunchersTitle" Text="Launchers" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CardTitleBrush}" Margin="0,0,0,8"/>
          <StackPanel x:Name="GamesLaunchersPanel"/>
        </StackPanel>
      </Border>

      <Border x:Name="GamesTweaksCard" Grid.Column="2" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock x:Name="GamesTweaksTitle" Text="Tweaks" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource CardTitleBrush}" Margin="0,0,0,8"/>
          <StackPanel x:Name="GamesTweaksPanel"/>
        </StackPanel>
      </Border>

    </Grid>
  </ScrollViewer>

    <Border x:Name="GamesLogCard" Grid.Row="3" Style="{StaticResource SoftwareStickyCardStyle}" Margin="0,10,0,10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="125"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GamesLogTitle" Text="Journal PowerShell Jeux" FontWeight="SemiBold" Foreground="{DynamicResource CardTitleBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="GamesExportLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Exporter"/><Button x:Name="GamesOpenLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le fichier" Margin="7,0,0,0"/><Button x:Name="GamesClearLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Vider le journal" Margin="7,0,0,0"/></StackPanel></Grid>
      <RichTextBox x:Name="GamesLogBox" Grid.Row="1" Style="{StaticResource LogRichTextBoxStyle}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,9,0,0"/>
    </Grid>
  </Border>
</Grid>
