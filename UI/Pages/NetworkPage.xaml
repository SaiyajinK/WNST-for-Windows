<Grid x:Name="NetworkPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="NetworkTitle" Text="Réseau" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="NetworkSubtitle" Text="Diagnostiquez la connexion, les ports, le proxy et la disponibilité d’un hôte." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0"><StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
              <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="NetworkCommandsTitle" Text="Diagnostic réseau" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="NetworkTargetBox" ToolTip="exemple.com ou 1.1.1.1"/><TextBlock x:Name="NetworkTargetPlaceholder" Text="Adresse IP ou domaine à diagnostiquer…" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/></Grid><Button x:Name="NetworkDiagnosticButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Diagnostiquer"/><Button x:Name="TraceRouteButton" Grid.Column="4" Style="{StaticResource AccentHoverButtonStyle}" Content="Tracer la route"/></Grid>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="netstat -an" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="NetstatHint" Text="Affiche les connexions et ports en écoute sans résolution de noms." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="NetstatButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ipconfig" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="IpconfigHint" Text="Affiche la configuration IP actuelle des cartes réseau." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="IpconfigButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ipconfig /flushdns" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="FlushDnsNowHint" Text="Vide immédiatement le cache DNS." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="FlushDnsNowButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ipconfig /release" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ReleaseIpHint" Text="Libère les adresses DHCP et coupe temporairement la connexion." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="ReleaseIpButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="ipconfig /renew" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="RenewIpHint" Text="Demande de nouvelles adresses DHCP aux cartes réseau." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="RenewIpButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <TextBlock x:Name="NetworkLogTitle" Text="Journal réseau" FontWeight="SemiBold" Margin="0,10,0,5"/><RichTextBox x:Name="NetworkOutputBox" Style="{StaticResource LogRichTextBoxStyle}" Height="180" IsReadOnly="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"><FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="11"><Paragraph Margin="0"/></FlowDocument></RichTextBox><WrapPanel HorizontalAlignment="Right" Margin="0,7,0,0"><Button x:Name="ExportNetworkLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Exporter le journal" Margin="0,0,7,0"/><Button x:Name="OpenNetworkLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le fichier" Margin="0,0,7,0"/><Button x:Name="OpenNetworkLogFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier" Margin="0,0,7,0"/><Button x:Name="ClearNetworkLogButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Vider le journal"/></WrapPanel>
              </StackPanel></Border>
              <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PingTitle" Text="Ping" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="PingHint" Text="Teste en quatre paquets la disponibilité d’un nom d’hôte ou d’une adresse IP." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,10"/><Border Background="Transparent" BorderThickness="0" Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="PingTargetBox" ToolTip="exemple.com ou 1.1.1.1"/><TextBlock x:Name="PingTargetPlaceholder" Text="Adresse IP ou domaine à tester avec Ping…" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/></Grid><Button x:Name="PingButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Ping"/></Grid></Border><TextBlock x:Name="PingLogTitle" Text="Journal ping" FontWeight="SemiBold" Margin="0,10,0,5"/><RichTextBox x:Name="PingOutputBox" Style="{StaticResource LogRichTextBoxStyle}" Height="180" IsReadOnly="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"><FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="11"><Paragraph Margin="0"/></FlowDocument></RichTextBox><WrapPanel HorizontalAlignment="Right" Margin="0,7,0,0"><Button x:Name="ExportPingLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Exporter le journal" Margin="0,0,7,0"/><Button x:Name="OpenPingLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le fichier" Margin="0,0,7,0"/><Button x:Name="OpenPingLogFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier" Margin="0,0,7,0"/><Button x:Name="ClearPingLogButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Vider le journal"/></WrapPanel></StackPanel></Border>
              <Border Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="OpenPortsTitle" Text="Ports ouverts" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="OpenPortsHint" Text="Ports TCP en écoute et points de terminaison UDP avec leur application." Foreground="{DynamicResource MutedBrush}" Margin="0,3,12,9" FontSize="12"/></StackPanel><Button x:Name="RefreshOpenPortsButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Actualiser" VerticalAlignment="Center"/></Grid><Border Grid.Row="1" Background="{DynamicResource GridBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Padding="1"><DataGrid x:Name="OpenPortsGrid" BorderThickness="0" Height="190" SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2"><DataGrid.ContextMenu><ContextMenu x:Name="OpenPortsContextMenu" Style="{StaticResource BackupContextMenuStyle}"><MenuItem x:Name="OpenPortFirewallMenuItem" Style="{StaticResource BackupMenuItemStyle}" Header="Créer une règle pare-feu"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn x:Name="OpenPortProtocolColumn" Header="Protocole" Binding="{Binding Protocol}" Width="80"/><DataGridTextColumn x:Name="OpenPortAddressColumn" Header="Adresse locale" Binding="{Binding LocalAddress}" Width="150"/><DataGridTextColumn x:Name="OpenPortNumberColumn" Header="Port" Binding="{Binding LocalPort}" Width="70"/><DataGridTextColumn x:Name="OpenPortAppColumn" Header="Application" Binding="{Binding ProcessName}" Width="160"/><DataGridTextColumn x:Name="OpenPortPidColumn" Header="PID" Binding="{Binding PID}" Width="65"/><DataGridTextColumn x:Name="OpenPortPathColumn" Header="Chemin" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid></Border><Button x:Name="OpenPortToFirewallButton" Grid.Row="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Créer une règle pare-feu" HorizontalAlignment="Right" Margin="0,9,0,0" IsEnabled="False"/></Grid></Border>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="ProxyTitle" Text="Proxy Windows" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="ProxyHint" Text="Configure le proxy utilisateur Windows (WinINET) sans toucher au proxy système WinHTTP." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" FontSize="12"/><Border Background="Transparent" BorderThickness="0" Padding="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="100"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProxyHostBox" ToolTip="proxy.example.com"/><TextBox x:Name="ProxyPortBox" Grid.Column="2" ToolTip="8080"/><Button x:Name="EnableProxyButton" Grid.Column="4" Style="{StaticResource AccentHoverButtonStyle}" Content="Appliquer"/><Button x:Name="DisableProxyButton" Grid.Column="6" Style="{StaticResource DangerHoverButtonStyle}" Content="Désactiver"/><Button x:Name="ResetProxyButton" Grid.Column="8" Style="{StaticResource DangerHoverButtonStyle}" Content="Réinitialiser"/></Grid></Border><TextBlock x:Name="ProxyStatusText" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
          </Grid>
