<Grid x:Name="DnsPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="DnsTitle" Text="DNS" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="DnsSubtitle" Text="Configurez rapidement les serveurs DNS de chaque carte réseau." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0"><StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DnsAdapterTitle" Text="Carte réseau" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="DnsAdapterHint" Text="Choisissez précisément l’interface à modifier." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" FontSize="12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DnsAdapterCombo" DisplayMemberPath="DisplayName"/><Button x:Name="RefreshDnsAdaptersButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Actualiser"/></Grid><Border Margin="0,9,0,0" Padding="10,8" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="CurrentDnsTitle" Text="DNS actuellement utilisés" FontWeight="SemiBold"/><TextBlock x:Name="CurrentDnsValue" Text="—" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DnsPresetsTitle" Text="DNS prédéfinis" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="DnsPresetsHint" Text="Sélectionnez un fournisseur puis vérifiez ses adresses avant de les appliquer." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" FontSize="12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DnsPresetCombo" DisplayMemberPath="Name"/><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock><Run x:Name="DnsPresetIpv4Label" Text="IPv4" FontWeight="SemiBold"/><Run Text="  ·  "/><Run x:Name="DnsPresetIpv4Value"/></TextBlock><TextBlock Grid.Row="1" Margin="0,5,0,0"><Run x:Name="DnsPresetIpv6Label" Text="IPv6" FontWeight="SemiBold"/><Run Text="  ·  "/><Run x:Name="DnsPresetIpv6Value"/></TextBlock></Grid><Button x:Name="ApplyDnsPresetButton" Grid.Column="3" Style="{StaticResource AccentHoverButtonStyle}" Content="Appliquer" VerticalAlignment="Center"/></Grid></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="CustomDnsTitle" Text="DNS personnalisés" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="CustomDnsHint" Text="Laissez les champs inutilisés vides. Les adresses sont vérifiées avant toute modification." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10" FontSize="12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="DnsIpv4PrimaryLabel" Text="IPv4 principal" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="DnsIpv4PrimaryBox" Grid.Column="1"/><TextBlock x:Name="DnsIpv4SecondaryLabel" Grid.Column="3" Text="IPv4 secondaire" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="DnsIpv4SecondaryBox" Grid.Column="4"/><TextBlock x:Name="DnsIpv6PrimaryLabel" Grid.Row="2" Text="IPv6 principal" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="DnsIpv6PrimaryBox" Grid.Row="2" Grid.Column="1"/><TextBlock x:Name="DnsIpv6SecondaryLabel" Grid.Row="2" Grid.Column="3" Text="IPv6 secondaire" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="DnsIpv6SecondaryBox" Grid.Row="2" Grid.Column="4"/></Grid><Button x:Name="ApplyCustomDnsButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Appliquer les DNS personnalisés" HorizontalAlignment="Right" Margin="0,9,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DnsActionsTitle" Text="Actions DNS" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="DnsActionsHint" Text="Revenez aux serveurs automatiques ou vérifiez immédiatement la résolution de noms." Foreground="{DynamicResource MutedBrush}" Margin="0,3,18,0" TextWrapping="Wrap" FontSize="12"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><Button x:Name="ResetAutomaticDnsButton" Style="{StaticResource AccentHoverButtonStyle}" Content="DNS automatique" Margin="0,0,7,0"/><Button x:Name="TestDnsButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Tester" Margin="0,0,7,0"/><Button x:Name="FlushDnsPageButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Vider le cache DNS"/></WrapPanel></Grid></Border><TextBlock x:Name="DnsStatusText" Foreground="{DynamicResource MutedBrush}" Margin="1,7,0,0" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
          </Grid>
