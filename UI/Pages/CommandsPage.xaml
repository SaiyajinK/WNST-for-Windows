<Grid x:Name="CommandsPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="CommandsTitle" Text="Windows" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="CommandsSubtitle" Text="Maintenance, intégrité et raccourcis système Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0"><StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
              <Border x:Name="WindowsActionsCard" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="WindowsCommandsTitle" Text="Actions Windows" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="KillPowerShellTitle" Text="Fermer les autres PowerShell" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="KillPowerShellHint" Text="Arrête powershell.exe et pwsh.exe, sauf le processus qui exécute WNST." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="KillPowerShellButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="ClearTempTitle" Text="Vider les fichiers temporaires" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="ClearTempHint" Text="Supprime ce qui peut l’être dans les dossiers Temp utilisateur et Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="ClearTempButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="RestartExplorerTitle" Text="Redémarrer l’Explorateur Windows" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="RestartExplorerHint" Text="Relance le bureau, la barre des tâches et les fenêtres de l’Explorateur." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="RestartExplorerButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Exécuter"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HomeGalleryTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Masquer Accueil et Galerie" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="HomeGalleryHint" Text="Masque Accueil et Galerie dans le volet de navigation de l’Explorateur." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="HomeGalleryToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid><Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ClockSecondsTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Secondes dans l’horloge" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ClockSecondsHint" Text="Affiche les secondes dans l’horloge de la barre des tâches." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="ClockSecondsToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock x:Name="LocalUserTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Ajouter un utilisateur local" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="LocalUserHint" Text="Le mot de passe peut rester vide. Le compte est standard sauf si l’option administrateur est cochée." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="5"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="LocalUserNameLabel" Text="Nom d’utilisateur" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBox x:Name="LocalUserNameBox" Grid.Row="2" MaxLength="20"/><TextBlock x:Name="LocalUserPasswordLabel" Grid.Column="2" Text="Mot de passe (facultatif)" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><PasswordBox x:Name="LocalUserPasswordBox" Grid.Row="2" Grid.Column="2" MaxLength="127"/></Grid><CheckBox x:Name="LocalUserAdminCheck" Content="Compte administrateur (décoché : compte standard)" Margin="0,9,0,7"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="CreateLocalUserButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Créer l’utilisateur"/><Button x:Name="DeleteLocalUserButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Supprimer l’utilisateur" Margin="7,0,0,0" Visibility="Collapsed"/></WrapPanel></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SafeModeBootTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Ajouter le mode sans échec au démarrage" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="SafeModeBootHint" Text="Crée une copie de l’entrée Windows actuelle configurée en mode sans échec minimal." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,20,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SafeModeBootButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ajouter"/><Button x:Name="DeleteSafeModeBootButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Supprimer" Margin="7,0,0,0" Visibility="Collapsed"/></StackPanel></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="GodModeToolTitle" Text="GodMode" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="GodModeToolHint" Text="Ouvre dans l’Explorateur la liste complète des réglages avancés de Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="GodModeButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir GodMode"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="PowerOptionsTitle" Text="Options d’alimentation Windows" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="PowerOptionsHint" Text="Arrête ou redémarre le PC." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ShutdownButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Arrêter" Margin="0,0,7,0"/><Button x:Name="RestartComputerButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Redémarrer"/></StackPanel></Grid></Border>
              </StackPanel></Border>
              <Border x:Name="SystemConsolesCard" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SystemConsolesTitle" Text="Consoles système Windows" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="ThisPcTaskManagerTitle" Text="Gestionnaire des tâches" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="ThisPcTaskManagerHint" Text="Affiche les processus, les performances, les applications et les services actifs." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="ThisPcTaskManagerButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="MsConfigTitle" Text="Configuration système" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="MsConfigHint" Text="Gère le démarrage, les services de diagnostic et les options avancées." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="MsConfigButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="ServicesTitle" Text="Services Windows" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="ServicesHint" Text="Affiche et administre les services installés." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="ServicesButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="GroupPolicyTitle" Text="Stratégie de groupe locale" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="GroupPolicyHint" Text="Ouvre l’éditeur des stratégies locales, lorsqu’il est disponible." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="GroupPolicyButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="RegistryTitle" Text="Éditeur du Registre" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="RegistryHint" Text="Ouvre l’éditeur des paramètres avancés de Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="RegeditButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="TaskSchedulerTitle" Text="Planificateur de tâches" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="TaskSchedulerHint" Text="Affiche et gère les tâches automatisées de Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="TaskSchedulerButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="EventViewerTitle" Text="Observateur d’événements" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="EventViewerHint" Text="Consulte les journaux système, application et sécurité de Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="EventViewerButton" Grid.Column="1" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir"/></Grid></Border>
                <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="WingetUpgradeTitle" Text="Mises à jour des applications" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,0"/><TextBlock x:Name="WingetUpgradeHint" Text="Lance winget upgrade --all dans un terminal visible." Foreground="{DynamicResource MutedBrush}" Margin="0,3,20,0" FontSize="12"/></StackPanel><Button x:Name="WingetUpgradeButton" Grid.Column="1" Style="{StaticResource GreenHoverButtonStyle}" Content="Rechercher les mises à jour"/></Grid></Border>
              </StackPanel></Border>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource StickyLogCardStyle}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="WindowsLogTitle" Text="Journal des commandes Windows" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="ExportWindowsLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Exporter" Margin="0,0,7,0"/>
                    <Button x:Name="OpenWindowsLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le fichier" Margin="0,0,7,0"/>
                    <Button x:Name="OpenWindowsLogFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier" Margin="0,0,7,0"/>
                    <Button x:Name="ClearWindowsLogButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Vider"/>
                  </WrapPanel>
                </Grid>
                <RichTextBox x:Name="WindowsOutputBox" Style="{StaticResource LogRichTextBoxStyle}" Height="145" Margin="0,6,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12"><FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="12"><Paragraph Margin="0"/></FlowDocument></RichTextBox>
              </StackPanel>
            </Border>
          </Grid>
