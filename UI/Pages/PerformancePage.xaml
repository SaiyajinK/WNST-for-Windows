<Grid x:Name="PerformancePage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="PerformanceTitle" Text="Performance" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="PerformanceSubtitle" Text="Ajustez les performances de Windows et des jeux avec des réglages réversibles." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0">
    <StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
      <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PerformanceWindowsTitle" Text="Windows" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="PerformanceStateText" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="RefreshPerformanceButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Actualiser"/></StackPanel></Grid>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DefenderCpuTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Limiter Defender pendant les analyses" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="DefenderCpuHint" Text="Définit la charge moyenne visée par Microsoft Defender pendant les analyses." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><Grid Grid.Column="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="52"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="DefenderCpuSlider" Style="{StaticResource AccentSliderStyle}" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="150" VerticalAlignment="Center"/><TextBlock x:Name="DefenderCpuValue" Grid.Column="1" Text="50 %" TextAlignment="Right" VerticalAlignment="Center" Margin="7,0"/><Button x:Name="ApplyDefenderCpuButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Appliquer" VerticalAlignment="Center"/></Grid></Grid></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PowerModeTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Mode de gestion de l’alimentation" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="PowerModeHint" Text="Sélectionne un profil réellement disponible sur cet ordinateur." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/><TextBlock x:Name="PowerModeStatus" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,4,20,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="PowerEcoButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Éco" MinWidth="150" Margin="0,0,0,6"/><Button x:Name="PowerNormalButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Normal" MinWidth="150" Margin="0,0,0,6"/><Button x:Name="PowerHighButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Hautes performances" MinWidth="150"/></StackPanel></Grid></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TransparencyTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Transparence" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="TransparencyHint" Text="Active ou désactive les effets de transparence de Windows." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="TransparencyToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AnimationsTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver toutes les animations Windows" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="AnimationsHint" Text="Désactive les animations des fenêtres, de la barre des tâches, des menus, des info-bulles, des listes et des contrôles." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="AnimationsToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ShutdownAnimationTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver la fenêtre Arrêt/Redémarrage animée" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="ShutdownAnimationHint" Text="Retire les messages d’état animés pendant l’arrêt et le redémarrage." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="ShutdownAnimationToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="NotificationsTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Supprimer le centre et les notifications" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="NotificationsHint" Text="Coupe le centre, les fenêtres, les sons, les notifications réseau et les services associés." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="EndTaskTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Terminer la tâche dans la barre des tâches" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="EndTaskHint" Text="Ajoute Terminer la tâche au menu contextuel des applications de la barre des tâches." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="EndTaskToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LegacyContextTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Restaurer l’ancien menu contextuel" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="LegacyContextHint" Text="Affiche directement le menu contextuel classique de Windows." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="LegacyContextToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LegacyExplorerTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Activer l’ancien Explorateur Windows" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="LegacyExplorerHint" Text="Restaure l’interface classique de l’Explorateur lorsqu’elle est encore disponible sur cette version." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="LegacyExplorerToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
      </StackPanel></Border>

      <TextBlock x:Name="PerformanceGamesTitle" Text="Jeux" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,10"/>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GameDvrTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver Game DVR et la Game Bar" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="GameDvrHint" Text="Coupe l’enregistrement vidéo en arrière-plan et les raccourcis de la Game Bar." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="GameDvrToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BackgroundThrottleTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver la limitation des performances/FPS en arrière-plan" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="BackgroundThrottleHint" Text="Désactive la limitation énergétique de Windows ; un jeu ou un pilote peut conserver sa propre limite." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="BackgroundThrottleToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LatencyTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Améliorer la latence système" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="LatencyHint" Text="Ajuste le profil multimédia Windows pour favoriser les tâches de jeu." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="LatencyToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="GamingTasksTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver les tâches planifiées non essentielles" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="GamingTasksHint" Text="Désactive uniquement une liste contrôlée de tâches Cartes et Xbox Game Save lorsqu’elles existent." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="GamingTasksToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BackgroundServicesTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver les services lourds et options d’arrière-plan" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="BackgroundServicesHint" Text="Désactive uniquement Cartes, Fax, partage multimédia et mode démonstration lorsqu’ils existent." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0" TextWrapping="Wrap"/></StackPanel><ToggleButton x:Name="BackgroundServicesToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="TaskbarOptimizeTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Désactiver les badges de la barre des tâches" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="TaskbarOptimizeHint" Text="Masque les compteurs et indicateurs affichés sur les boutons des applications." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="TaskbarOptimizeToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
        <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StartupOptimizeTitle" Foreground="{DynamicResource CardTitleBrush}" Text="Accélérer l’ouverture des applications et le démarrage" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="StartupOptimizeHint" Text="Supprime le délai de lancement après connexion et réduit le délai d’ouverture des menus." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,20,0"/></StackPanel><ToggleButton x:Name="StartupOptimizeToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
      </StackPanel></Border>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource StickyLogCardStyle}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PerformanceLogTitle" Text="Journal des performances" FontWeight="SemiBold" VerticalAlignment="Center"/><WrapPanel Grid.Column="1" HorizontalAlignment="Right"><Button x:Name="ExportPerformanceLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Exporter" Margin="0,0,7,0"/><Button x:Name="OpenPerformanceLogButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le fichier" Margin="0,0,7,0"/><Button x:Name="OpenPerformanceLogFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier" Margin="0,0,7,0"/><Button x:Name="ClearPerformanceLogButton" Style="{StaticResource DangerHoverButtonStyle}" Content="Vider"/></WrapPanel></Grid><RichTextBox x:Name="PerformanceOutputBox" Style="{StaticResource LogRichTextBoxStyle}" Height="145" Margin="0,6,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12"><FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="12"><Paragraph Margin="0"/></FlowDocument></RichTextBox></StackPanel></Border>
</Grid>
