<Grid x:Name="SettingsPage" Visibility="Collapsed" Style="{StaticResource ScrollablePageContentStyle}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Style="{StaticResource PageHeaderContentStyle}" VerticalAlignment="Center"><TextBlock x:Name="SettingsTitle" Text="Paramètres" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/><TextBlock x:Name="SettingsSubtitle" Text="Langue, apparence et stockage local." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0"><StackPanel Style="{StaticResource PageScrollContentStyle}" Margin="0,14,0,0">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="LanguageLabel" Text="Langue de l'interface" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="LanguageHint" Text="Le changement est appliqué immédiatement et mémorisé." Foreground="{DynamicResource MutedBrush}" Margin="0,3,18,0" FontSize="12"/></StackPanel><ComboBox x:Name="LanguageCombo" Grid.Column="1" VerticalAlignment="Center" ItemTemplate="{StaticResource LanguageItemTemplate}"/></Grid></Border>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="AppearanceTitle" Text="Apparence" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="AppearanceHint" Text="Personnalisez l’apparence générale de l’interface." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,20" FontSize="12"/>
                <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitlebarAnimationLabel" Text="Animation de la barre de titre"/><TextBlock x:Name="TitlebarAnimationHint" Text="Anime le nom de l’application avec un effet de frappe." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,18,0"/></StackPanel><ToggleButton x:Name="TitlebarAnimationToggle" Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" VerticalAlignment="Center"/></Grid>
                <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,4"/>
                <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ThemeLabel" Text="Thème"/><TextBlock x:Name="ThemeHint" Text="Choisissez le thème d’affichage de l’interface." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,18,0"/></StackPanel><StackPanel Grid.Column="1"><ComboBox x:Name="ThemeCombo" ItemTemplate="{StaticResource ThemeItemTemplate}" VerticalAlignment="Center"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="CreateThemeButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Créer..."/><Button x:Name="ModifyThemeButton" Grid.Column="2" Style="{StaticResource AccentHoverButtonStyle}" Content="Modifier..."/><Button x:Name="DeleteThemeButton" Grid.Column="4" Style="{StaticResource DangerHoverButtonStyle}" Content="Supprimer"/></Grid></StackPanel></Grid>
                <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,4"/>
                <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="78"/><ColumnDefinition Width="8"/><ColumnDefinition Width="84"/><ColumnDefinition Width="8"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="AccentLabel" Text="Couleur d'accentuation"/><TextBlock x:Name="AccentHint" Text="Définit la couleur principale utilisée dans l’interface." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,18,0"/></StackPanel><TextBox x:Name="AccentColorBox" Grid.Column="1" Padding="9,3" MaxLength="24" ToolTip="#1A9FFF ou 26,159,255" VerticalAlignment="Center"/><Button x:Name="ChooseAccentButton" Grid.Column="3" Style="{StaticResource AccentHoverButtonStyle}" Content="Choisir" VerticalAlignment="Center"/><Button x:Name="ResetAccentButton" Grid.Column="5" Style="{StaticResource AccentHoverButtonStyle}" Content="Réinitialiser" VerticalAlignment="Center"/><Border Grid.Column="7" Width="34" Height="34" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" VerticalAlignment="Center"/></Grid>
                <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,4"/>
                <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="CornerLabel" Text="Coins"/><TextBlock x:Name="CornerHint" Text="Ajuste l’arrondi de la fenêtre, des cartes et des contrôles." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,18,0"/></StackPanel><ComboBox x:Name="CornerCombo" Grid.Column="1" ItemTemplate="{StaticResource ThemeItemTemplate}" VerticalAlignment="Center"/></Grid>
                <Separator Background="{DynamicResource ControlBorderBrush}" Opacity="0.5" Margin="0,4"/>
                <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="158"/><ColumnDefinition Width="8"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="UiScaleLabel" Text="Échelle de l’interface WNST"/><TextBlock x:Name="UiScaleHint" Text="Agrandit uniquement WNST et applique le changement immédiatement." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,18,0" TextWrapping="Wrap"/></StackPanel><ComboBox x:Name="UiScaleCombo" Grid.Column="1" ItemTemplate="{StaticResource ThemeItemTemplate}" VerticalAlignment="Center"/><Button x:Name="ApplyUiScaleButton" Grid.Column="3" Style="{StaticResource AccentHoverButtonStyle}" Content="Appliquer" VerticalAlignment="Center"/></Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource CardTitleBrush}" x:Name="DataFolderLabel" Text="Dossier des données" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/><TextBlock x:Name="DataFolderHint" Text="Emplacement utilisé par WNST pour ses données locales." Foreground="{DynamicResource MutedBrush}" Margin="0,3,18,0" FontSize="12"/><TextBlock x:Name="DataFolderValue" Foreground="#D6CAB7" Margin="0,2,18,0" TextWrapping="Wrap" FontSize="12"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><Button x:Name="ChooseDataFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Choisir" Margin="0,0,6,0"/><Button x:Name="ResetDataFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Réinitialiser" Margin="0,0,6,0"/><Button x:Name="OpenDataFolderButton" Style="{StaticResource AccentHoverButtonStyle}" Content="Ouvrir le dossier des données"/></WrapPanel></Grid></Border>
            </StackPanel></ScrollViewer>
          </Grid>
