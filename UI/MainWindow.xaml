<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="MainWindow" Title="WNST" Width="1080" Height="780" MinWidth="940" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource TextBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="{DynamicResource AppCornerRadius}" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <!-- WNST_STYLES -->

  <Border x:Name="WindowFrame" Margin="1" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Background="{DynamicResource WindowBrush}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>

      <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
          <Viewbox
                   Width="24"
                   Height="24"
                   Stretch="Uniform">
            <Canvas Width="512" Height="512">
          <Path Data="M 126.176,147.386 L 131.132,142.429 L 212.018,223.315 L 207.061,228.272 Z"
                    Fill="{DynamicResource AccentBrush}"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="1"
                    Opacity="0.4"/>
          
              <Path Data="M 299.298,292.656 L 304.255,287.699 L 385.141,368.585 L 380.184,373.542 Z"
                    Fill="{DynamicResource AccentBrush}"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="1"
                    Opacity="0.4"/>
          
              <Path Data="M 364.950,399.250 L 364.950,434.350 L 147.140,434.350 L 147.140,399.250 Z"
                    Fill="{DynamicResource AccentBrush}"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="1"
                    Opacity="0.4"/>
          
              <Path Data="M 365.400,82.260 L 365.400,117.360 L 147.590,117.360 L 147.590,82.260 Z"
                    Fill="{DynamicResource AccentBrush}"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="1"
                    Opacity="0.4"/>
          <Path Data="F0 M430.61,354.52v-197.61c24.1-7.79,41.54-30.4,41.54-57.09,0-33.14-26.86-60-60-60s-60,26.86-60,60c0,10.16,2.53,19.72,6.99,28.11l-75.22,75.22c-8.22-4.23-17.54-6.64-27.42-6.64-10.66,0-20.67,2.79-29.35,7.67l-74.93-74.93c4.91-8.7,7.72-18.73,7.72-29.43,0-33.14-26.86-60-60-60s-60,26.86-60,60c0,27.03,17.88,49.88,42.45,57.39v197.03c-24.57,7.51-42.45,30.36-42.45,57.39,0,33.14,26.86,60,60,60s60-26.86,60-60c0-12.2-3.65-23.53-9.9-33l72.59-72.59c9.64,6.61,21.3,10.48,33.87,10.48,9.44,0,18.37-2.19,26.31-6.07l75.23,75.23c-3.77,7.85-5.89,16.65-5.89,25.95,0,33.14,26.86,60,60,60s60-26.86,60-60c0-26.7-17.44-49.31-41.54-57.09ZM203.14,283.92l-74.82,74.82c-3.43-1.84-7.05-3.36-10.84-4.52v-197.03c9.54-2.91,18.07-8.13,24.93-15.01l71.78,71.78c-10.93,10.87-17.69,25.91-17.69,42.54,0,9.89,2.41,19.2,6.64,27.42ZM256.5,286.16c-16.38,0-29.66-13.28-29.66-29.66s13.28-29.66,29.66-29.66,29.66,13.28,29.66,29.66-13.28,29.66-29.66,29.66ZM395.51,353.97c-11.14,3.21-20.94,9.55-28.4,18.02l-70.7-70.7c12.32-10.99,20.09-26.98,20.09-44.79,0-12.57-3.87-24.23-10.48-33.87l72.88-72.88c5.05,3.37,10.64,5.98,16.62,7.71v196.51Z"
                    Fill="{DynamicResource AccentBrush}"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="1"
          />
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="TxtAppTitle" Text="WNST" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="  •  " Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtAppSubtitleAnimated" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtAppSubtitleCaret" Text="|" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="MinimizeButton" Grid.Column="1" Style="{StaticResource TitleButtonStyle}" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="11" Height="1" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Data="M0,0.5 L11,0.5"/></Button>
        <Button x:Name="MaximizeButton" Grid.Column="2" Style="{StaticResource TitleButtonStyle}" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Viewbox Width="11" Height="11"><Canvas Width="14" Height="14"><Path x:Name="MaximizeGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,2 L12,2 L12,12 L2,12 Z"/></Canvas></Viewbox></Button>
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseButtonStyle}" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Viewbox Width="11" Height="11"><Canvas Width="12" Height="12"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L11,11 M11,1 L1,11"/></Canvas></Viewbox></Button>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="Auto" MinWidth="185" MaxWidth="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{DynamicResource SidebarBrush}">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="PrimaryNavScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel x:Name="PrimaryNavPanel" Margin="0,10,0,0">
            <Button x:Name="SidebarToggleButton" Style="{StaticResource SidebarToggleButtonStyle}" HorizontalAlignment="Right" Margin="0,0,8,4" ToolTip="Réduire le menu"><Viewbox Width="13" Height="13"><Canvas Width="16" Height="16"><Path x:Name="SidebarToggleGlyph" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M10,3 L5,8 L10,13"/></Canvas></Viewbox></Button>
            <Button x:Name="NavHome" Style="{StaticResource NavButtonStyle}" Tag="Selected"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M3,1.5 L9.8,1.5 L13.5,5.2 L13.5,14.5 L3,14.5 Z"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M9.8,1.5 L9.8,5.2 L13.5,5.2"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" Data="M5.2,8 L11.3,8 M5.2,10.5 L11.3,10.5 M5.2,13 L9.2,13"/></Canvas></Viewbox><TextBlock x:Name="NavHomeText" Text="Host" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavHistory" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8,1.75 A6.25,6.25 0 1 1 8,14.25 A6.25,6.25 0 1 1 8,1.75 M8,4.25 L8,8 L10.75,9.5"/></Canvas></Viewbox><TextBlock x:Name="NavHistoryText" Text="Historique" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavDiagnostics" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1.5,8 L4.2,8 L5.8,4.2 L8.2,11.8 L10.2,7 L14.5,7"/><Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Opacity="0.65"/></Canvas></Viewbox><TextBlock x:Name="NavDiagnosticsText" Text="Diagnostics" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavPerformance" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M9.3,1.3 L3.4,8.4 L7.1,8.4 L6.3,14.7 L12.6,6.7 L8.8,6.7 Z"/></Canvas></Viewbox><TextBlock x:Name="NavPerformanceText" Text="Performance" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavGames" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.1,5.2 C2.4,5.2 1.5,7.1 1.5,10.2 C1.5,12.6 2.3,14 3.6,14 C4.6,14 5.3,12.7 6.1,11.7 L9.9,11.7 C10.7,12.7 11.4,14 12.4,14 C13.7,14 14.5,12.6 14.5,10.2 C14.5,7.1 13.6,5.2 11.9,5.2 Z M5,4 L6.2,2.8 L9.8,2.8 L11,4 M4,8.5 L6.5,8.5 M5.25,7.25 L5.25,9.75"/><Ellipse Canvas.Left="10.2" Canvas.Top="7.2" Width="1.4" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Ellipse Canvas.Left="12" Canvas.Top="9" Width="1.4" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox><TextBlock x:Name="NavGamesText" Text="Jeux" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavApplications" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeLineJoin="Round" Data="M4.5,1.5 L7.5,3.1 L7.5,6.5 L4.5,8.1 L1.5,6.5 L1.5,3.1 Z M11.5,1.5 L14.5,3.1 L14.5,6.5 L11.5,8.1 L8.5,6.5 L8.5,3.1 Z M8,7.1 L11,8.7 L11,12.1 L8,14 L5,12.1 L5,8.7 Z"/></Canvas></Viewbox><TextBlock x:Name="NavApplicationsText" Text="Applications" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavConnections" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Ellipse Canvas.Left="1.5" Canvas.Top="5.5" Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Ellipse Canvas.Left="9.5" Canvas.Top="1.5" Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M6.5,7 L9.7,5 M6.5,9 L9.7,11"/></Canvas></Viewbox><TextBlock x:Name="NavConnectionsText" Text="Connexions" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavNetwork" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,6 C5.4,2.8 10.6,2.8 14,6 M4.5,8.8 C6.5,7 9.5,7 11.5,8.8 M7,11.3 C7.6,10.8 8.4,10.8 9,11.3"/><Ellipse Canvas.Left="7.15" Canvas.Top="12.2" Width="1.7" Height="1.7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Canvas></Viewbox><TextBlock x:Name="NavNetworkText" Text="Réseau" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavFirewall" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M8,1.5 L13,3.4 L13,7.4 C13,10.8 10.8,13.4 8,14.5 C5.2,13.4 3,10.8 3,7.4 L3,3.4 Z"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Data="M5.2,8 L7.1,9.8 L10.9,5.8"/></Canvas></Viewbox><TextBlock x:Name="NavFirewallText" Text="Pare-feu" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavDns" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" Data="M2.3,8 L13.7,8 M8,1.8 C10.6,4 10.6,12 8,14.2 M8,1.8 C5.4,4 5.4,12 8,14.2"/></Canvas></Viewbox><TextBlock x:Name="NavDnsText" Text="DNS" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavCommands" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox x:Name="NavCommandsIcon" Width="16" Height="16"><Canvas Width="16" Height="16"><Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="5.7" Height="5.7" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/><Rectangle Canvas.Left="8.8" Canvas.Top="1.5" Width="5.7" Height="5.7" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/><Rectangle Canvas.Left="1.5" Canvas.Top="8.8" Width="5.7" Height="5.7" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/><Rectangle Canvas.Left="8.8" Canvas.Top="8.8" Width="5.7" Height="5.7" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/></Canvas></Viewbox><TextBlock x:Name="NavCommandsText" Text="Windows" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavAdvanced" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12"/><Ellipse Canvas.Left="4" Canvas.Top="2" Width="4" Height="4" Fill="{DynamicResource SidebarBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/><Ellipse Canvas.Left="9" Canvas.Top="6" Width="4" Height="4" Fill="{DynamicResource SidebarBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/><Ellipse Canvas.Left="6" Canvas.Top="10" Width="4" Height="4" Fill="{DynamicResource SidebarBrush}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/></Canvas></Viewbox><TextBlock x:Name="NavAdvancedText" Text="Advanced" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavDebloat" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" Data="M2,4 L8,1.5 L14,4 L14,12 L8,14.5 L2,12 Z M2,4 L8,6.5 L14,4 M8,6.5 L8,14.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" Data="M5,9.2 L6.8,11 L11,7"/></Canvas></Viewbox><TextBlock x:Name="NavDebloatText" Text="Debloat" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="NavThisPc" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Rectangle Canvas.Left="1.5" Canvas.Top="2" Width="13" Height="9" RadiusX="2" RadiusY="2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Data="M6,14 L10,14 M8,11 L8,14"/></Canvas></Viewbox><TextBlock x:Name="NavThisPcText" Text="Ce PC" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Ellipse Canvas.Left="6" Canvas.Top="6" Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M8,0 L8,3 M8,13 L8,16 M0,8 L3,8 M13,8 L16,8 M2.3,2.3 L4.4,4.4 M11.6,11.6 L13.7,13.7 M13.7,2.3 L11.6,4.4 M4.4,11.6 L2.3,13.7"/></Canvas></Viewbox><TextBlock x:Name="NavSettingsText" Text="Paramètres" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavAbout" Style="{StaticResource NavButtonStyle}"><StackPanel Orientation="Horizontal"><Viewbox Width="16" Height="16"><Canvas Width="16" Height="16"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><Ellipse Canvas.Left="7.25" Canvas.Top="4.5" Width="1.5" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M8,7 L8,12"/></Canvas></Viewbox><TextBlock x:Name="NavAboutText" Text="À propos" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>
          <StackPanel x:Name="SidebarStatusPanel" Grid.Row="3" Margin="18,0,10,13">
            <TextBlock x:Name="TxtAdminMode" Text="Mode administrateur" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
            <Viewbox x:Name="SidebarAdminShield" Width="16" Height="16" Visibility="Collapsed"><Canvas Width="16" Height="16"><Path Stroke="{DynamicResource NavTextBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M8,1.5 L13,3.4 L13,7.4 C13,10.8 10.8,13.4 8,14.5 C5.2,13.4 3,10.8 3,7.4 L3,3.4 Z"/></Canvas></Viewbox>
            <StackPanel x:Name="SidebarReadyPanel" Orientation="Horizontal" Margin="0,6,0,0"><Ellipse x:Name="SidebarReadyDot" Width="6" Height="6" Fill="#4CC38A" Margin="0,0,7,0"/><TextBlock x:Name="TxtReady" Text="Prêt" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/></StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="16,12,16,8">
          <!-- Host -->
          <!-- WNST_PAGE_HomePage -->

          <!-- Historique -->
          <!-- WNST_PAGE_HistoryPage -->

          <!-- Diagnostics -->
          <!-- WNST_PAGE_DiagnosticsPage -->

          <!-- Performance -->
          <!-- WNST_PAGE_PerformancePage -->

          <!-- Jeux -->
          <!-- WNST_PAGE_GamesPage -->

          <!-- Applications -->
          <!-- WNST_PAGE_ApplicationsPage -->

          <!-- Connexions -->
          <!-- WNST_PAGE_ConnectionsPage -->

          <!-- Réseau -->
          <!-- WNST_PAGE_NetworkPage -->

          <!-- Windows -->
          <!-- WNST_PAGE_CommandsPage -->

          <!-- Debloat -->
          <!-- WNST_PAGE_DebloatPage -->

          <!-- Advanced -->
          <!-- WNST_PAGE_AdvancedPage -->

          <!-- Pare-feu -->
          <!-- WNST_PAGE_FirewallPage -->

          <!-- DNS -->
          <!-- WNST_PAGE_DnsPage -->

          <!-- Ce PC -->
          <!-- WNST_PAGE_ThisPcPage -->

          <!-- Paramètres -->
          <!-- WNST_PAGE_SettingsPage -->

          <!-- À propos -->
          <!-- WNST_PAGE_AboutPage -->
        </Grid>
      </Grid>

      <Grid Grid.RowSpan="3" Panel.ZIndex="900" VerticalAlignment="Bottom" Background="{DynamicResource WindowBrush}" IsHitTestVisible="False"><TextBlock x:Name="StatusBarText" Text="" Visibility="Collapsed" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11"/><ProgressBar x:Name="BusyProgress" Height="2" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="Transparent"/></Grid>
       <Canvas Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10" Margin="0,0,2,2" IsHitTestVisible="False"><Path Stroke="{DynamicResource WindowBorderBrush}" StrokeThickness="1" StrokeStartLineCap="Round" Data="M 5,8 L 8,5 M 7,8 L 8,7"/></Canvas>
       <Border x:Name="WindowBorderOverlay" Grid.RowSpan="3" Panel.ZIndex="1000" Margin="-1" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource AppCornerRadius}" Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
